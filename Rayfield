-- Hàm tìm server & hop server
local function fetchServers(placeId, maxPlayersFilter)
	local cursor = ""
	local resultList = {}

	for _ = 1, 5 do
		local url = string.format(
			"https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100%s",
			placeId,
			cursor ~= "" and ("&cursor=" .. cursor) or ""
		)

		local ok, raw = pcall(function()
			return game:HttpGet(url)
		end)
		if not ok or not raw then break end

		local okDecode, decoded = pcall(function()
			return HttpService:JSONDecode(raw)
		end)
		if not okDecode or not decoded or not decoded.data then break end

		for _, srv in ipairs(decoded.data) do
			if srv.id and srv.id ~= game.JobId and srv.playing < srv.maxPlayers then
				if not maxPlayersFilter or maxPlayersFilter(srv) then
					table.insert(resultList, srv)
				end
			end
		end

		if decoded.nextPageCursor then
			cursor = decoded.nextPageCursor
		else
			break
		end
	end

	return resultList
end

local function hopServer()
	local servers = fetchServers(game.PlaceId)
	if #servers > 0 then
		local chosen = servers[math.random(1, #servers)]
		TeleportService:TeleportToPlaceInstance(game.PlaceId, chosen.id, LocalPlayer)
	else
		Rayfield:Notify({
			Title = "Server Hop",
			Content = "Không tìm thấy server khả dụng khác.",
			Duration = 4
		})
	end
end

local function findOnePlayerServer()
	local servers = fetchServers(game.PlaceId, function(srv)
		return srv.playing == 1
	end)

	if #servers > 0 then
		foundOnePlayerServer = servers[1].id
		Rayfield:Notify({
			Title = "Tìm Server 1 Người",
			Content = "Đã tìm thấy server 1 người: " .. tostring(foundOnePlayerServer),
			Duration = 5
		})
	else
		foundOnePlayerServer = nil
		Rayfield:Notify({
			Title = "Tìm Server 1 Người",
			Content = "Hiện không có server 1 người trống.",
			Duration = 4
		})
	end
end

-- Vòng lặp chính mỗi frame
RunService.RenderStepped:Connect(function()
	local char = LocalPlayer.Character
	local hum = getHumanoid(char)
	local root = getRootPart(char)

	if hum then
		if walkSpeedEnabled then
			hum.WalkSpeed = targetWalkSpeed
		end
		if jumpPowerEnabled then
			hum.UseJumpPower = true
			hum.JumpPower = targetJumpPower
		end
	end

	if noclipEnabled and char then
		applyNoclip(char)
	end

	if flyEnabled and root then
		local cam = workspace.CurrentCamera
		if not flyBodyGyro or not flyBodyVelocity then
			startFly()
		end
		if flyBodyGyro and flyBodyVelocity and cam then
			flyBodyGyro.CFrame = CFrame.lookAt(root.Position, root.Position + cam.CFrame.LookVector)
			flyBodyVelocity.Velocity = getFlyDirection()
		end
	end

	if fovCircle then
		local mousePos = UserInputService:GetMouseLocation()
		fovCircle.Visible = aimbotEnabled and fovEnabled
		fovCircle.Radius = fovRadius
		fovCircle.Position = mousePos
		fovCircle.Color = rainbowEnabled and rainbowColor or Color3.fromRGB(255, 255, 255)
	end

	if aimbotEnabled and (UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) or not UserInputService.MouseEnabled) then
		local cam = workspace.CurrentCamera
		local targetPart = getClosestTargetInFOV()
		if cam and targetPart then
			local targetCFrame = CFrame.lookAt(cam.CFrame.Position, targetPart.Position)
			cam.CFrame = cam.CFrame:Lerp(targetCFrame, math.clamp(aimSmoothness, 0.01, 1))
		end
	end

	updateESP()
end)

