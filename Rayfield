-- Hàm hỗ trợ
local function getHumanoid(char)
	if not char then return nil end
	return char:FindFirstChildWhichIsA("Humanoid")
end

local function isTeammate(target)
	if not LocalPlayer or not target or target == LocalPlayer then return false end
	if LocalPlayer.Neutral or target.Neutral then return false end
	if LocalPlayer.Team ~= nil and target.Team ~= nil then
		return LocalPlayer.Team == target.Team
	end
	return LocalPlayer.TeamColor == target.TeamColor
end

local function resolveAimPart(char, choice)
	if not char then return nil end
	if choice == "Head" then
		return char:FindFirstChild("Head")
	elseif choice == "HumanoidRootPart" then
		return char:FindFirstChild("HumanoidRootPart")
	elseif choice == "Torso" then
		return char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso") or char:FindFirstChild("HumanoidRootPart")
	elseif choice == "Left Arm" then
		return char:FindFirstChild("Left Arm") or char:FindFirstChild("LeftUpperArm") or char:FindFirstChild("LeftHand")
	elseif choice == "Right Arm" then
		return char:FindFirstChild("Right Arm") or char:FindFirstChild("RightUpperArm") or char:FindFirstChild("RightHand")
	elseif choice == "Left Leg" then
		return char:FindFirstChild("Left Leg") or char:FindFirstChild("LeftUpperLeg") or char:FindFirstChild("LeftFoot")
	elseif choice == "Right Leg" then
		return char:FindFirstChild("Right Leg") or char:FindFirstChild("RightUpperLeg") or char:FindFirstChild("RightFoot")
	end
	return char:FindFirstChild(choice) or char:FindFirstChild("Head")
end

local function isVisible(part)
	if not wallCheckEnabled then return true end
	if not part then return false end
	local cam = workspace.CurrentCamera
	if not cam then return false end

	local origin = cam.CFrame.Position
	local direction = part.Position - origin
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude

	local ignoreList = {}
	if LocalPlayer.Character then table.insert(ignoreList, LocalPlayer.Character) end
	if part.Parent then table.insert(ignoreList, part.Parent) end

	params.FilterDescendantsInstances = ignoreList
	params.IgnoreWater = true

	local result = workspace:Raycast(origin, direction, params)
	return result == nil
end
local UserInputService = game:GetService("UserInputService")

local function getRootPart(char)
	if not char then return nil end
	return char:FindFirstChild("HumanoidRootPart") or char:FindFirstChildWhichIsA("BasePart")
end

-- Xử lý Noclip
local function restoreCollisions()
	for part, canCollide in pairs(savedCollisions) do
		if part and part.Parent then
			part.CanCollide = canCollide
		end
	end
	table.clear(savedCollisions)
end

local function applyNoclip(char)
	if not char then return end
	for _, obj in ipairs(char:GetDescendants()) do
		if obj:IsA("BasePart") then
			if savedCollisions[obj] == nil then
				savedCollisions[obj] = obj.CanCollide
			end
			obj.CanCollide = false
		end
	end
end

-- Xử lý Fly
local function stopFly()
	if flyBodyGyro then
		flyBodyGyro:Destroy()
		flyBodyGyro = nil
	end
	if flyBodyVelocity then
		flyBodyVelocity:Destroy()
		flyBodyVelocity = nil
	end
end

local function startFly()
	stopFly()
	local char = LocalPlayer.Character
	local root = getRootPart(char)
	local hum = getHumanoid(char)
	if not char or not root then return end

	if hum then
		hum.PlatformStand = true
	end

	flyBodyGyro = Instance.new("BodyGyro")
	flyBodyGyro.P = 9e4
	flyBodyGyro.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
	flyBodyGyro.CFrame = root.CFrame
	flyBodyGyro.Parent = root

	flyBodyVelocity = Instance.new("BodyVelocity")
	flyBodyVelocity.Velocity = Vector3.zero
	flyBodyVelocity.MaxForce = Vector3.new(9e9, 9e9, 9e9)
	flyBodyVelocity.Parent = root
end

local function getFlyDirection()
	local cam = workspace.CurrentCamera
	if not cam then return Vector3.zero end

	local moveDir = Vector3.zero
	if UserInputService:IsKeyDown(Enum.KeyCode.W) then
		moveDir += cam.CFrame.LookVector
	end
	if UserInputService:IsKeyDown(Enum.KeyCode.S) then
		moveDir -= cam.CFrame.LookVector
	end
	if UserInputService:IsKeyDown(Enum.KeyCode.A) then
		moveDir -= cam.CFrame.RightVector
	end
	if UserInputService:IsKeyDown(Enum.KeyCode.D) then
		moveDir += cam.CFrame.RightVector
	end
	if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
		moveDir += Vector3.new(0, 1, 0)
	end
	if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
		moveDir -= Vector3.new(0, 1, 0)
	end

	if moveDir.Magnitude > 0 then
		return moveDir.Unit * flySpeed
	end
	return Vector3.zero
end

-- Vòng FOV cho Aimbot (an toàn nếu executor hỗ trợ Drawing)
local fovCircle = nil
local hasDrawing, DrawingLib = pcall(function()
	return Drawing
end)

if hasDrawing and DrawingLib then
	fovCircle = DrawingLib.new("Circle")
	fovCircle.Thickness = 1.5
	fovCircle.NumSides = 64
	fovCircle.Radius = fovRadius
	fovCircle.Filled = false
	fovCircle.Visible = false
	fovCircle.Color = rainbowColor
end

local function getClosestTargetInFOV()
	local cam = workspace.CurrentCamera
	if not cam then return nil end

	local mousePos = UserInputService:GetMouseLocation()
	local closestPart = nil
	local shortestDist = fovRadius

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			if teamCheckEnabled and isTeammate(player) then
				continue
			end

			local char = player.Character
			local hum = getHumanoid(char)
			if char and hum and hum.Health > 0 then
				local targetPart = resolveAimPart(char, aimPartChoice)
				if targetPart and isVisible(targetPart) then
					local screenPos, onScreen = cam:WorldToViewportPoint(targetPart.Position)
					if onScreen and screenPos.Z > 0 then
						local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
						if dist <= shortestDist then
							shortestDist = dist
							closestPart = targetPart
						end
					end
				end
			end
		end
	end

	return closestPart
end

-- Hệ thống ESP gọn nhẹ
local espObjects = {}

local function clearESPForPlayer(player)
	local data = espObjects[player]
	if data then
		if data.Highlight then data.Highlight:Destroy() end
		if data.Billboard then data.Billboard:Destroy() end
		espObjects[player] = nil
	end
end

local function updateESP()
	if not espEnabled then
		for player in pairs(espObjects) do
			clearESPForPlayer(player)
		end
		return
	end

	local localRoot = getRootPart(LocalPlayer.Character)

	for _, player in ipairs(Players:GetPlayers()) do
		if player == LocalPlayer then
			clearESPForPlayer(player)
			continue
		end

		local mate = isTeammate(player)
		if enemyOnly and mate then
			clearESPForPlayer(player)
			continue
		end

		local char = player.Character
		local head = char and char:FindFirstChild("Head")
		local root = getRootPart(char)
		local hum = getHumanoid(char)

		if not char or not head or not root or not hum or hum.Health <= 0 then
			clearESPForPlayer(player)
			continue
		end

		local data = espObjects[player]
		if not data then
			local hl = Instance.new("Highlight")
			hl.Name = "TuanRayfield_ESP"
			hl.FillTransparency = 0.65
			hl.OutlineTransparency = 0
			hl.Adornee = char
			hl.Parent = char

			local bb = Instance.new("BillboardGui")
			bb.Name = "TuanRayfield_Tag"
			bb.Adornee = head
			bb.Size = UDim2.new(0, 160, 0, 36)
			bb.StudsOffset = Vector3.new(0, 2.2, 0)
			bb.AlwaysOnTop = true
			bb.Parent = char

			local label = Instance.new("TextLabel")
			label.Size = UDim2.new(1, 0, 1, 0)
			label.BackgroundTransparency = 1
			label.TextStrokeTransparency = 0.2
			label.Font = Enum.Font.GothamBold
			label.TextSize = 13
			label.Parent = bb

			data = { Highlight = hl, Billboard = bb, Label = label }
			espObjects[player] = data
		end

		local colorToUse = mate and friendColor or (rainbowEnabled and rainbowColor or Color3.fromRGB(255, 60, 60))
		data.Highlight.FillColor = colorToUse
		data.Highlight.OutlineColor = colorToUse

		local distText = ""
		if localRoot then
			distText = string.format(" [%dm]", math.floor((root.Position - localRoot.Position).Magnitude))
		end
		data.Label.Text = string.format("%s | %d HP%s", player.DisplayName, math.floor(hum.Health), distText)
		data.Label.TextColor3 = colorToUse
	end
end

